# Required for signed access tokens in production; use a long, unique secret.
JWT_SECRET=replace-with-a-long-random-secret

# Include the exact deployed website origin(s); cookies require credentialed CORS.
CORS_ORIGIN=https://www.tastifyy.in,https://tastifyy.in

# Use "none" for the current cross-site Render API; use "lax" with a same-site API domain.
AUTH_COOKIE_SAME_SITE=none

# Meta WhatsApp Cloud API credentials. Keep these server-side only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Optional: comma-separated recipient numbers. Defaults to 7498784109,9322586177.
WHATSAPP_ALERT_RECIPIENTS=7498784109,9322586177